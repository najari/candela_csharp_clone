			<TEXTTABLE id="_203">
				<QUALIFIER>FailureModeIdentifier</QUALIFIER>
				<NAME>Failure Mode Identifier</NAME>
				<DESCRIPTION>Texttable that lists all DTC failure mode identifiers according to SAE J1939 -73 (FMI)</DESCRIPTION>
