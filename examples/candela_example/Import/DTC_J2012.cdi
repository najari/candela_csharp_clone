        <DTC number="8753">
          <ERRORTEXT>O2 Sensor Signal Circuit Shorted to Heater Circuit</ERRORTEXT>
          <RECORD>
            <RECORDITEM itemmappingref="_1">Bank 1 Sensor 1</RECORDITEM>
            <RECORDITEM itemmappingref="_2">P2231-P2236, This diagnostic is for the sensors (both wide band and switching) that have a PWM controlled heater. If the heater shorts to the signal circuit, the control module can determine this since the signal circuit will be shorted high at the same frequency that the heaters are operating at.</RECORDITEM>
          </RECORD>
        </DTC>
