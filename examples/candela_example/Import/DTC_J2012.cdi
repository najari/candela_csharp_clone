        <DTC number="9797">
          <ERRORTEXT>"A" Rocker Arm Actuator Control Circuit/Open</ERRORTEXT>
          <RECORD>
            <RECORDITEM itemmappingref="_1">Bank 1</RECORDITEM>
            <RECORDITEM itemmappingref="_2">The "A" rocker arm actuator shall be either the "intake," "left," or "front" rocker arm actuator. Left/Right and Front/Rear are determined as if viewed from the driver's seating position.  Bank 1 contains cylinder number one, Bank 2 is the opposite bank.  Where only one rocker arm actuator is used for both conditions "A" and "B", use the DTCs for "A".</RECORDITEM>
          </RECORD>
        </DTC>
