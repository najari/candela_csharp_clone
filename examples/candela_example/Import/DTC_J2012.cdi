        <DTC number="16">
          <ERRORTEXT>"A" Camshaft Position Actuator Circuit / Open</ERRORTEXT>
          <RECORD>
            <RECORDITEM itemmappingref="_1">Bank 1</RECORDITEM>
            <RECORDITEM itemmappingref="_2">The "A" camshaft shall be either the "intake," "left," or "front" camshaft. Left/Right and Front/Rear are determined as if viewed from the driver's seating position.  Bank 1 contains cylinder number one, Bank 2 is the opposite bank</RECORDITEM>
