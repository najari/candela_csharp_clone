<ECU id='_000002B727594EB0' oid='C0C7D328C5B74a2f8CEB689BBB2DBD33' temploid='{A120ED60-20AB-4660-97EA-CD85CDFA5B23}' maxCombinedServiceIds='5'>
<NAME>
<TUV xml:lang='en-US'>Multilingual-Example</TUV>
<TUV xml:lang='de-DE'>Mehrsprachiges Beispiel</TUV>
<TUV xml:lang='fr-FR'>Multilingual-Example</TUV>
<TUV xml:lang='ja'>Multilingual-Example</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC fs='220'>This CANdela document template shows how </FC>
<FC bcol='15793151' b='1' fs='220'>CANdelaStudio</FC>
<FC fs='220'> supports multiple languages within a document.</FC>
</PARA>
<PARA><FC fs='220'>It does not claim to be complete and is not intended for productive use!</FC>
</PARA>
</TUV>
<TUV xml:lang='de-DE' struct='1'><PARA><FC fs='220'>Diese CANdela-Dokumentvorlage zeigt die Unterstützung der Mehrsprachigkeit in </FC>
<FC bcol='65280' b='1' fs='220'>CANdelaStudio</FC>
<FC fs='220'>.</FC>
</PARA>
<PARA><FC fs='220'>Sie hat nicht den Anspruch, vollständig zu sein, und ist nicht für den produktiven Einsatz geeignet!</FC>
</PARA>
</TUV>
<TUV xml:lang='fr-FR' struct='1'><PARA><FC fs='220'>Ce template CANdela démontre les capacités multilingue de </FC>
<FC bcol='65280' b='1' fs='220'>CANdelaStudio</FC>
<FC fs='220'>.</FC>
</PARA>
<PARA><FC fs='220'>Il n'a pas la prétention d'être complet et n'est pas approprié pour un usage en développement Série.</FC>
</PARA>
</TUV>
<TUV xml:lang='ja' struct='1'><PARA><FC fs='220'>このCANdelaドキュメント テンプレートは、</FC>
<FC bcol='65280' b='1' fs='220'>CANdelaStudio</FC>
<FC fs='220'>がどのようにドキュメントで複数言語をサポートできるのか示しています。</FC>
</PARA>
<PARA><FC fs='220'>このドキュメントは完成されたものではなく、生産用途を意図したものではありません。</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Multilingual_Example</QUAL>
