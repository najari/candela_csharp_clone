<ENUMDEF id='_0000020DE90D9D80' oid='{2C0E1BDF-0E99-48d4-92B7-46AA2B347056}' attrcatref='_0000020DE9089B60' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>PacketHandlerOption</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Provide type of current PacketHandler for first found service positive response. Restriction: Only evaluated if attribute 'PacketHandlerSupport' of diagnostic class is set to 'all'.</TUV>
</DESC>
